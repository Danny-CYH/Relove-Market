APP_NAME=ReloveMarket
APP_ENV=local

# Run php artisan key:generate
APP_KEY=

APP_DEBUG=true

# Local URL 127.0.0.1:8000
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Check for the connection type of the database. For example: Supabase is pgsql
DB_CONNECTION=connectiontype

# Check for the host of the database connections
DB_HOST=127.0.0.1

# Each database have different connection, check on the internet
DB_PORT=portnumber

# Database name, username and password are provided on the database, check on it
DB_DATABASE=databasename
DB_USERNAME=yourusername
DB_PASSWORD=yourpassword

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailer function are available based on the type of the email being used, if using gmail the type is smtp
MAIL_MAILER=log

MAIL_SCHEME=null

# The host of the meail are depend on the type of the email being used, if using smtp then the host would be smtp.gmail.com
MAIL_HOST=127.0.0.1

# Port are different based on the mail type being used, if using smtp the port would be 587
MAIL_PORT=2525

# username, password and address are the email information
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_BASE_URL="${APP_URL}/storage/"

# Configurations of the pusher real time communication credential, check on the Pusher offical web
VITE_PUSHER_APP_KEY=pusher_app_key
VITE_PUSHER_APP_CLUSTER=pusher_app_cluster

# Configuration of the stripe payment credential, check on the Stripe payment official web
VITE_STRIPE_KEY=stripe_public_key
STRIPE_SECRET=stripe_secret_key

# Custom machine learning services which run the local server, the url is http://127.0.0.1:5000
ML_SERVICE_URL=ml_service_url

# The base url are the root project storage link URL for displaying and storing image in the root project. The url is http://127.0.0.1:8000/storage/
VITE_BASE_URL=base_url_for_frontend (displaying images, etc.)
